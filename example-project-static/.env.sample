### MANDATORY

# Domain Configuration (primary domain used for cert dir & server_name first token)
DOMAIN_NAME=example.com
DOMAIN_ADMIN_EMAIL=admin@example.com

# Enables static-site mode: no docker-compose.yml, no container. Nginx serves
# a synced copy of STATIC_SOURCE_DIR directly.
STATIC_SITE=yes

# Directory (relative to this project's root) containing the already-built
# site to serve — e.g. `build`, `dist`, `out`, `public`, `_site`, depending on
# your static site generator. Deliberately NOT hardcoded to `static/`: many
# frameworks (e.g. SvelteKit) already use a top-level `static/` for
# unprocessed source assets, not the final build output.
STATIC_SOURCE_DIR=build

### OPTIONAL
# Comma- or space-separated list of additional hostnames (SANs)
DOMAIN_ALIASES=www.example.com


### WEBHOOK (works normally for static sites, same as app-container projects)

# Required
WEBHOOK_URL=/webhook
PAYLOAD_SIGNATURE=supersecret-shared-with-github

# Optional
REPO_LOCATION=/srv/projects/<project-name>
TARGET_BRANCH=main

# If your STATIC_SOURCE_DIR isn't already committed pre-built, point this at
# a script that builds it (e.g. `npm run build`) — it runs after git pull and
# before the static sync, so the sync picks up freshly-built output.
CI_PIPELINE_LOCATION=/srv/ci/pipelines/myproject
